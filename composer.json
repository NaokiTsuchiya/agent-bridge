{
    "name": "naoki-tsuchiya/agent-bridge",
    "description": "Bridge between chat frontends and Claude Code sessions",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "ext-swoole": "*",
        "be-framework/be": "0.x-dev",
        "bear/resource": "^1.33",
        "naoki-tsuchiya/ray-di-context": "^0.3",
        "ray/di": "^2.22"
    },
    "require-dev": {
        "carthage-software/mago": "^1.46",
        "phpunit/phpunit": "^13.3",
        "swoole/ide-helper": "^6.2"
    },
    "autoload": {
        "psr-4": {
            "NaokiTsuchiya\\AgentBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NaokiTsuchiya\\AgentBridge\\Tests\\": "tests/",
            "NaokiTsuchiya\\AgentBridge\\FakeClaude\\": [
                "fake-claude/",
                "fake-claude-tests/"
            ],
            "NaokiTsuchiya\\AgentBridge\\StubSlack\\": [
                "stub-slack/",
                "stub-slack-tests/"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:fake-claude",
            "@test:stub-slack",
            "@test:integration"
        ],
        "compile": [
            "@compile:serve",
            "@compile:slack"
        ],
        "compile:serve": "@php vendor/bin/ray-di-compile bootstrap.php \"$PWD\" serve",
        "compile:slack": "@php vendor/bin/ray-di-compile bootstrap.php \"$PWD\" slack",
        "test:unit": "phpunit --testsuite agent-bridge --exclude-group integration --testdox",
        "test:fake-claude": "phpunit --testsuite fake-claude --testdox",
        "test:stub-slack": "phpunit --testsuite stub-slack --testdox",
        "test:integration": "phpunit --group integration --testdox",
        "test:coverage": "phpunit --coverage-clover=var/coverage/clover.xml --coverage-text --testdox",
        "lint": "mago lint",
        "analyze": "mago analyze",
        "fmt": "mago format",
        "fmt-check": "mago format --check"
    }
}
